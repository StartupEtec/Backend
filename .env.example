# Entorno del servidor
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Base de datos (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DB_NAME=ondemand_db

# Caché (Redis). Si no se define o no está disponible, se usa caché en memoria.
REDIS_URL=redis://localhost:6379

# Seguridad
JWT_SECRET=tu_secreto_seguro_para_jwt
REFRESH_TOKEN_SECRET=tu_secreto_seguro_para_refresh_tokens
ENCRYPTION_KEY=tu_clave_de_encriptacion_aes256_de_32_bytes

# Escrow / proveedor de pagos (simulado). true fuerza el fallo del cargo a la tarjeta
# para probar el flujo de cancelación automática de la orden.
SIMULATE_CHARGE_FAILURE=false

# Integración con Stripe
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_firma_webhook_stripe

# Subida de archivos (imágenes adjuntas de mensajes)
UPLOAD_DIR=uploads

# Monitoreo y Alertas
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/tu_webhook_aqui
ELASTICSEARCH_URL=http://localhost:9200
APM_LATENCY_THRESHOLD_MS=1000

# Notificaciones Push (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Notificaciones Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@app.com
SENDGRID_FROM_NAME=StartupPlatform

# Notificaciones SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Configuración de Notificaciones
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY_MS=1000

