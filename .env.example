# Entorno del servidor
PORT=3000
NODE_ENV=development
AUTO_APPROVE_WORKERS=false

# Orígenes permitidos por CORS, separados por coma.
# Si no se define, el default es solo `http://localhost:3000` y cualquier otro
# Origin recibe 403 CORS_ERROR.
#
# React Native no manda header `Origin` en las peticiones nativas, así que desde
# Expo Go normalmente no hace falta. Pero Expo Web y algunas herramientas de
# debug sí lo mandan: agregá el origen de Metro (`http://localhost:8081`) para
# probar en el navegador, y la IP LAN de tu máquina si probás desde el teléfono
# con Expo Go conectado a Metro en esa interfaz.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Base de datos (PostgreSQL). Producción siempre usa TLS con verificación del certificado.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_con_password_local_o_seguro
DB_NAME=ondemand_db
# Desarrollo: DB_SSL=true activa TLS (verificando el certificado).
DB_SSL=false
# Si el proveedor usa una CA propia, indicar la ruta al archivo .pem
# DB_SSL_CA=/ruta/al/ca.pem
# Solo para emergencias: desactiva la verificación (INSEGURO)
# DB_SSL_REJECT_UNAUTHORIZED=false

# Caché (Redis). Si no se define o no está disponible, se usa caché en memoria.
REDIS_URL=redis://localhost:6379

# Seguridad. Generar cada clave con: openssl rand -hex 32
# El servidor NO arranca si faltan o si siguen siendo placeholders.
JWT_SECRET=REEMPLAZAR_con_openssl_rand_hex_32
REFRESH_TOKEN_SECRET=REEMPLAZAR_con_openssl_rand_hex_32
JWT_RESET_SECRET=REEMPLAZAR_con_openssl_rand_hex_32
# Etiquetas para atar los tokens a esta app/entorno
JWT_ISSUER=ondemand-api
JWT_AUDIENCE=ondemand-client
ENCRYPTION_KEY=REEMPLAZAR_con_openssl_rand_hex_32

# Teléfonos: código de país por defecto usado para canonicalizar a E.164
# (formato canónico en register, login, forgot-password, verify-otp y resend-otp)
DEFAULT_PHONE_COUNTRY_CODE=+54

# OTP: intentos fallidos por código/usuario tras los cuales se invalida el OTP.
# Requiere el campo `otp_failed_attempts` (migración add_otp_attempts_and_canonical_phone).
OTP_MAX_ATTEMPTS=5

# Escrow / proveedor de pagos (simulado). true fuerza el fallo del cargo a la tarjeta
# para probar el flujo de cancelación automática de la orden.
SIMULATE_CHARGE_FAILURE=false

# Integración con Stripe
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_firma_webhook_stripe

# Subida de archivos (imágenes adjuntas de mensajes)
UPLOAD_DIR=uploads
# Base pública (sin /api/v1) para resolver /uploads/... en las respuestas de la API
PUBLIC_BASE_URL=http://localhost:3000

# Monitoreo y Alertas
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/tu_webhook_aqui
ELASTICSEARCH_URL=http://localhost:9200
APM_LATENCY_THRESHOLD_MS=1000

# Notificaciones Push (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Notificaciones Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@app.com
SENDGRID_FROM_NAME=StartupPlatform

# Notificaciones SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Configuración de Notificaciones
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY_MS=1000

SMTP_HOST=mx.laborin.app
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@laborin.app
SMTP_PASS=
SMTP_FROM=noreply@laborin.app
OTP_SEND_SMS=false
