{
  "name": "backend-service",
  "version": "1.0.0",
  "description": "Backend API for work on-demand digital platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --coverage",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "seed:dev": "knex seed:run",
    "seed:run": "knex seed:run",
    "seed:clear": "node src/database/seeds/clear.js",
    "swagger:export": "node scripts/export-openapi.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "redis": "^4.7.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.11.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "js-yaml": "^5.4.1",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
